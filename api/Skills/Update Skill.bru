meta {
  name: Update Skill
  type: http
  seq: 4
}

put {
  url: {{host}}/protected/skills/:skillId
  body: json
  auth: inherit
}

params:path {
  skillId: b79b1b8d-04d2-11f1-a980-de609b70bb75
}

body:json {
  {
    "name": "Skill with Defence",
    "category": "CUSTOM",
    "description": "custom skill description",
    "cost": 3,
    "type": "FIGHTING_MOVE",
    "poolModifiers": [
      {
        "poolType": "ARMOUR",
        "modifierValue": 2,
        "edgeValue": 0
      },
      {
        "poolType": "MIGHT",
        "modifierValue": -1,
        "edgeValue": 0
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
