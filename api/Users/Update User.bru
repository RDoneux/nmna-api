}

body:json {
  {
    "displayName": "Updated Display Name",
    "username": "updateddd@username.com",
    "password": "new-password"
  }
}

tests {
  const json = res.getBody();
  bru.setEnvVar("accessToken", json.accessToken);
  bru.setEnvVar("refreshToken", json.refreshToken);
}

settings {
  encodeUrl: true
  timeout: 0
}
