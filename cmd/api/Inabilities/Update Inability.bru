}

body:json {
  {
    "name": "updated inability name",
    "description": "udpated inability description",
    "poolModifiers": [
      {
        "poolType": "SPEED",
        "modifierValue": -5000,
        "edgeValue": 0
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
